{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":prHourlyLimit4",
    ":prConcurrentLimit20",
    ":preserveSemverRanges"
  ],
  "reviewersFromCodeOwners": true,
  "assigneesFromCodeOwners": true,
  "rebaseWhen": "behind-base-branch",
  "labels": [
    "Renovate :wrench:"
  ],
  "packageRules": [
    {
      "groupName": "Silverback",
      "groupSlug": "silverback",
      "matchPackageNames": [
        "Silverback.{/,}**"
      ]
    },
    {
      "groupName": "Microsoft.CodeAnalysis",
      "groupSlug": "microsoft-codeanalysis",
      "matchPackageNames": [
        "Microsoft.CodeAnalysis.{/,}**"
      ]
    },
    {
      "description": "Re-apply bump for bare NuGet versions (overrides :preserveSemverRanges)",
      "matchManagers": ["nuget"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Bundle all GitHub workflow (Actions) updates into one PR",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    },
    {
      "description": "Limit reviewdog action updates to one PR per week (Mondays)",
      "matchManagers": ["github-actions"],
      "matchPackageNames": [
        "reviewdog/**"
      ],
      "groupName": "reviewdog",
      "groupSlug": "reviewdog",
      "schedule": ["* * * * 1"],
      "prConcurrentLimit": 1,
      "prHourlyLimit": 1
    }
  ],
  "ignorePaths": []
}
